PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL connection string
DATABASE_URL=postgres://iwmqt_user:your_secure_password@localhost:5432/iwmqt

# Once concurrent connections warrant pooling (e.g. a shared/staging environment, not a
# single local dev process), point DATABASE_URL at PgBouncer instead - same DB, same
# credentials, just proxied (docker-compose runs it on 6432 in transaction pool mode):
# DATABASE_URL=postgres://iwmqt_user:your_secure_password@localhost:6432/iwmqt

# JWT Secret for Authentication
JWT_SECRET=replace_with_a_long_random_string

# ClickHouse (event logging)
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=iwmqt_events

# Zoho SMTP Configuration
ZOHO_EMAIL=your_zoho_email@example.com
ZOHO_PASSWORD=replace_with_zoho_app_password
ZOHO_SMTP_HOST=smtppro.zoho.com

# Shared secret between this backend and the strategy-feed Python TCP listener
# (strategy-feed/server.py) - required on both the inbound ingest call (Python -> here) and
# the outbound command call (here -> Python's control port). Must match that server's own
# STRATEGY_FEED_SECRET. Requests without it are rejected in both directions.
STRATEGY_FEED_SECRET=replace_with_a_long_random_string

# Base URL of the strategy-feed Python listener's HTTP control port (its --control-port,
# default 9101) - this backend POSTs Deploy/Stop commands here to relay to connected
# strategist/algo TCP clients.
STRATEGY_FEED_CONTROL_URL=http://localhost:9101/command
