# Copy this to .env (never commit the real .env - it's already gitignored) and fill in the
# same STRATEGY_FEED_SECRET value as server/.env. Everything else has a sensible default and
# can be left unset.

STRATEGY_FEED_SECRET=replace_with_the_same_value_as_server/.env

# STRATEGY_FEED_HOST=0.0.0.0
# STRATEGY_FEED_PORT=9100
# STRATEGY_FEED_CONTROL_PORT=9101
# STRATEGY_FEED_BACKEND_URL=http://localhost:3000/api/strategy-feed/ingest
